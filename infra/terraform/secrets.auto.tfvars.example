# Copy to secrets.auto.tfvars (gitignored) and fill in real values. Each key is
# both the Secret Manager secret ID and the .env var name the VM assembles.
secrets = {
  POSTGRES_PASSWORD          = "CHANGEME"
  BUSCASAM_SECRET_KEY        = "CHANGEME" # ADR-0005 session signing key
  BUSCASAM_OIDC_CLIENT_ID    = "CHANGEME"
  BUSCASAM_OIDC_CLIENT_SECRET = "CHANGEME"
}
