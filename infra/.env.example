# BUSCASAM prod environment. In GCP (ADR-0013) the app VM generates this file at
# boot: secrets pulled from Secret Manager, non-secrets templated by Terraform's
# app-vm startup.sh. This file is the reference/dev copy. Keep in sync with the
# `Settings` schema in backend/src/buscasam/settings.py.

# --- versioning / images ---
BUSCASAM_VERSION=latest
# Artifact Registry path prefix, e.g. us-central1-docker.pkg.dev/buscasam/buscasam
BUSCASAM_IMAGE_REPO=
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
# Pinned HF revision SHA (ADR-0002).
EMBEDDING_MODEL_REVISION=

# --- postgres (db container) ---
POSTGRES_USER=buscasam
# Secret.
POSTGRES_PASSWORD=
POSTGRES_DB=buscasam

# --- backend (api / workers / backup) ---
BUSCASAM_ENV=prod
BUSCASAM_DATABASE_URL=postgresql+psycopg://buscasam:CHANGEME@db:5432/buscasam
BUSCASAM_TEI_URL=http://tei
BUSCASAM_BASE_URL=https://buscasam.unsam.edu.ar
BUSCASAM_INTERNAL_API_URL=http://api:8000/api
BUSCASAM_BLOB_ROOT=/var/lib/buscasam/blobs
BUSCASAM_MIN_SEMANTIC_SIMILARITY=0.84
BUSCASAM_FUZZY_WORD_SIMILARITY_THRESHOLD=0.3
BUSCASAM_SEMANTIC_ONLY_TRGM_THRESHOLD=0.4
BUSCASAM_EMBED_QUERY_TIMEOUT_S=0.5
BUSCASAM_EXTRACT_PIPELINE_VERSION=extract-v2
# Secrets (ADR-0005).
BUSCASAM_SECRET_KEY=
BUSCASAM_OIDC_CLIENT_ID=
BUSCASAM_OIDC_CLIENT_SECRET=
# Comma-separated emails granted the docente role regardless of hd (ADR-0005 item 17). Empty disables.
BUSCASAM_DOCENTE_EMAIL_ALLOWLIST=

# --- metadata LLM (optional; provider=vertex (Gemini) or ollama, ADR-0012) ---
BUSCASAM_METADATA_LLM_ENABLED=0
BUSCASAM_METADATA_LLM_PROVIDER=ollama
# ollama: self-hosted GPU VM (infra/terraform/modules/metadata-llm)
BUSCASAM_METADATA_LLM_URL=http://localhost:11434
BUSCASAM_METADATA_LLM_MODEL=qwen2.5:7b-instruct
# vertex: set PROVIDER=vertex, MODEL=gemini-2.5-flash, and VERTEX_PROJECT
BUSCASAM_VERTEX_PROJECT=
BUSCASAM_VERTEX_LOCATION=us-central1

# --- backup (ADR-0009 §11; defaults baked into backup_run.py) ---
BACKUP_RETENTION_DAYS=14
# BACKUP_DIR=/backup/buscasam

# --- nginx (ADR-0009 §9; a load balancer terminates TLS upstream) ---
SERVER_NAME=buscasam.unsam.edu.ar
# Comma/space-separated; GCP HTTPS LB front-end ranges trusted for X-Forwarded-*.
TRUSTED_PROXY_CIDR=130.211.0.0/22,35.191.0.0/16
